# Copy this file to secrets.yaml and fill with your real values.
# DO NOT commit secrets.yaml to git.

wifi_ssid: "YourHomeWiFi"
wifi_password: "YourWiFiPassword"

# Generate one per device with:  openssl rand -base64 32
api_encryption_key: "base64-encoded-32-byte-key-here=="

# Password used for OTA updates. Pick something long.
ota_password: "LongRandomOtaPassword"
